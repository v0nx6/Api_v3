{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",  
    "types": ["node"],
    
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    
    "moduleDetection": "force"
  },
  
  "include": ["**/*.ts"]
}
